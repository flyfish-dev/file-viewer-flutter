# Build-time preparation only. No runtime network downloads or host source edits.
set(FILE_VIEWER_CEF_PACKAGE_DIR "${CMAKE_CURRENT_LIST_DIR}/..")

function(prepare_prebuilt_files filepath)
  file(READ "${FILE_VIEWER_CEF_PACKAGE_DIR}/native-runtime-lock.json" lock_json)
  if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
    set(artifact_key linuxarm64)
  elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
    set(artifact_key linux64)
  else()
    message(FATAL_ERROR "Unsupported File Viewer Linux architecture: ${CMAKE_SYSTEM_PROCESSOR}")
  endif()
  string(JSON artifact_url GET "${lock_json}" artifacts ${artifact_key} url)
  string(JSON artifact_name GET "${lock_json}" artifacts ${artifact_key} filename)
  string(JSON artifact_sha256 GET "${lock_json}" artifacts ${artifact_key} sha256)
  set(cache_dir "$ENV{FILE_VIEWER_NATIVE_CACHE_DIR}")
  if(cache_dir STREQUAL "")
    set(cache_dir "${CMAKE_BINARY_DIR}/file_viewer_native_cache")
  endif()
  file(MAKE_DIRECTORY "${cache_dir}")
  set(archive "${cache_dir}/${artifact_name}")
  file(LOCK "${archive}.lock" GUARD FUNCTION TIMEOUT 600)
  if(NOT EXISTS "${archive}")
    if("$ENV{FILE_VIEWER_OFFLINE_BUILD}" STREQUAL "1")
      message(FATAL_ERROR "Offline CEF archive is missing: ${archive}")
    endif()
    file(DOWNLOAD "${artifact_url}" "${archive}.part"
      EXPECTED_HASH "SHA256=${artifact_sha256}" TLS_VERIFY ON STATUS download_status)
    list(GET download_status 0 download_code)
    if(NOT download_code EQUAL 0)
      file(REMOVE "${archive}.part")
      message(FATAL_ERROR "Failed to prepare the locked CEF runtime: ${download_status}")
    endif()
    file(RENAME "${archive}.part" "${archive}")
  endif()
  file(SHA256 "${archive}" actual_sha256)
  if(NOT actual_sha256 STREQUAL artifact_sha256)
    message(FATAL_ERROR "CEF archive hash mismatch: ${archive}")
  endif()
  if(EXISTS "${filepath}/file-viewer-runtime.sha256")
    file(READ "${filepath}/file-viewer-runtime.sha256" extracted_sha256)
    if(extracted_sha256 STREQUAL artifact_sha256)
      return()
    endif()
  endif()
  file(REMOVE_RECURSE "${filepath}.extract")
  file(MAKE_DIRECTORY "${filepath}.extract")
  file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${filepath}.extract")
  file(GLOB extracted_directories LIST_DIRECTORIES true "${filepath}.extract/*")
  list(LENGTH extracted_directories directory_count)
  if(NOT directory_count EQUAL 1)
    message(FATAL_ERROR "Unexpected CEF archive layout")
  endif()
  list(GET extracted_directories 0 extracted_directory)
  if(NOT EXISTS "${extracted_directory}/Release/libcef.so" OR NOT EXISTS "${extracted_directory}/include/cef_app.h")
    message(FATAL_ERROR "CEF runtime or headers are missing")
  endif()
  # The pinned upstream template recognizes arm64 but older generated copies
  # may call the same Linux architecture aarch64.
  file(READ "${extracted_directory}/cmake/cef_variables.cmake" cef_variables)
  string(REPLACE "\"\${CMAKE_HOST_SYSTEM_PROCESSOR}\" STREQUAL \"arm64\""
    "(\"\${CMAKE_HOST_SYSTEM_PROCESSOR}\" STREQUAL \"arm64\" OR \"\${CMAKE_HOST_SYSTEM_PROCESSOR}\" STREQUAL \"aarch64\")"
    cef_variables "${cef_variables}")
  file(WRITE "${extracted_directory}/cmake/cef_variables.cmake" "${cef_variables}")
  file(WRITE "${extracted_directory}/file-viewer-runtime.sha256" "${artifact_sha256}")
  file(REMOVE_RECURSE "${filepath}")
  file(RENAME "${extracted_directory}" "${filepath}")
  file(REMOVE_RECURSE "${filepath}.extract")
endfunction()
