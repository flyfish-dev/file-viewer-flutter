set(FILE_VIEWER_WINDOWS_PACKAGE_DIR "${CMAKE_CURRENT_LIST_DIR}")

function(file_viewer_prepare_webview2)
  file(READ "${FILE_VIEWER_WINDOWS_PACKAGE_DIR}/native-runtime-lock.json" lock_json)
  if(CMAKE_GENERATOR_PLATFORM MATCHES "[Aa][Rr][Mm]64" OR CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
    set(artifact_key arm64)
  elseif(CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(artifact_key x64)
  else()
    message(FATAL_ERROR "File Viewer supports only Windows x64 and ARM64")
  endif()
  string(JSON artifact_url GET "${lock_json}" artifacts ${artifact_key} url)
  string(JSON artifact_name GET "${lock_json}" artifacts ${artifact_key} filename)
  string(JSON artifact_sha256 GET "${lock_json}" artifacts ${artifact_key} sha256)
  set(cache_dir "$ENV{FILE_VIEWER_NATIVE_CACHE_DIR}")
  if(cache_dir STREQUAL "")
    set(cache_dir "${CMAKE_BINARY_DIR}/file_viewer_native_cache")
  endif()
  file(MAKE_DIRECTORY "${cache_dir}")
  set(archive "${cache_dir}/${artifact_name}")
  file(LOCK "${archive}.lock" GUARD FUNCTION TIMEOUT 600)
  if(NOT EXISTS "${archive}")
    if("$ENV{FILE_VIEWER_OFFLINE_BUILD}" STREQUAL "1")
      message(FATAL_ERROR "Offline WebView2 archive is missing: ${archive}")
    endif()
    file(DOWNLOAD "${artifact_url}" "${archive}.part"
      EXPECTED_HASH "SHA256=${artifact_sha256}" TLS_VERIFY ON STATUS download_status)
    list(GET download_status 0 download_code)
    if(NOT download_code EQUAL 0)
      file(REMOVE "${archive}.part")
      message(FATAL_ERROR "Failed to prepare the locked WebView2 runtime: ${download_status}")
    endif()
    file(RENAME "${archive}.part" "${archive}")
  endif()
  file(SHA256 "${archive}" actual_sha256)
  if(NOT actual_sha256 STREQUAL artifact_sha256)
    message(FATAL_ERROR "WebView2 archive hash mismatch: ${archive}")
  endif()
  set(runtime_directory "${CMAKE_BINARY_DIR}/file_viewer_webview2/${artifact_key}")
  set(stamp "${runtime_directory}/file-viewer-runtime.sha256")
  set(needs_extract TRUE)
  if(EXISTS "${stamp}")
    file(READ "${stamp}" extracted_sha256)
    if(extracted_sha256 STREQUAL artifact_sha256)
      set(needs_extract FALSE)
    endif()
  endif()
  if(needs_extract)
    file(REMOVE_RECURSE "${runtime_directory}")
    file(MAKE_DIRECTORY "${runtime_directory}")
    execute_process(COMMAND expand.exe "-F:*" "${archive}" "${runtime_directory}" RESULT_VARIABLE extract_status OUTPUT_QUIET)
    if(NOT extract_status EQUAL 0)
      message(FATAL_ERROR "Unable to extract the locked WebView2 Cabinet archive")
    endif()
    file(WRITE "${stamp}" "${artifact_sha256}")
  endif()
  file(GLOB_RECURSE runtime_executables "${runtime_directory}/msedgewebview2.exe")
  list(LENGTH runtime_executables executable_count)
  if(NOT executable_count EQUAL 1)
    message(FATAL_ERROR "Expected exactly one msedgewebview2.exe in the locked runtime")
  endif()
  list(GET runtime_executables 0 runtime_executable)
  get_filename_component(runtime_root "${runtime_executable}" DIRECTORY)
  install(DIRECTORY "${runtime_root}/" DESTINATION "FileViewerWebView2" COMPONENT Runtime)
endfunction()
